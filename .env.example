# Copy this file to .env before running Docker Compose.
# Compose automatically loads .env from the project directory.

# demo or live; live also requires SGE clients, configuration and networking.
GRIDENGINE_MODE=demo

# Host ports, bound to 127.0.0.1.
DEV_PORT=5173
WEB_PORT=8080
WEB_IP=127.0.0.1

# Nginx worker process count; use "auto" or a positive integer.
NGINX_WORKER_PROCESSES=2

# Production API cookies require HTTPS when true.
# Set false only for local HTTP testing. The dev service always uses false.
COOKIE_SECURE=true