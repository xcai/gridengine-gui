{
  "name": "gridengine-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "admin:users": "node server/users.js",
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:demo": "GRIDENGINE_MODE=demo concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:live": "GRIDENGINE_MODE=live concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "start": "node server/index.js",
    "start:demo": "GRIDENGINE_MODE=demo node server/index.js",
    "start:live": "GRIDENGINE_MODE=live node server/index.js",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:live": "vite build --mode live",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
